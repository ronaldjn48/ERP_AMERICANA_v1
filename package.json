{
  "name": "erp-americana-simulador",
  "private": true,
  "version": "1.0.0",
  "description": "Simulador educativo de decisiones gerenciales que integra ERP, CRM, e-commerce y automatización de procesos.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && vite build",
    "build:incrustado": "node scripts/build-embed.mjs",
    "docs:docente": "node scripts/contenido-docente.mjs"
  },
  "dependencies": {
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
